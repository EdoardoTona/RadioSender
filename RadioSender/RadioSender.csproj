<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ApplicationIcon>wwwroot/favicon.ico</ApplicationIcon>

		<!--<EnableDefaultContentItems>false</EnableDefaultContentItems>-->
		<GenerateBootstrapperOnBuild>true</GenerateBootstrapperOnBuild>
		<!--<PublishSingleFile>true</PublishSingleFile>-->

		<DefaultItemExcludes>wwwroot/**</DefaultItemExcludes>
		<DefaultItemExcludes>$(DefaultItemExcludes);ClientApp/node_modules/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<!--<Content Remove="tsconfig.json" />-->
		<Content Remove="libman.json" />
	</ItemGroup>

	<ItemGroup>
		<!--<None Include="tsconfig.json" />-->
		<None Include="libman.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CliWrap" Version="3.10.1" />
		<PackageReference Include="Cyotek.CircularBuffer" Version="2.0.0" />
		<PackageReference Include="ESC-POS-USB-NET" Version="1.1.3" />

		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Photino.NET" Version="4.0.16" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
		<PackageReference Include="MQTTnet" Version="5.1.0.1559" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
		<PackageReference Include="Hangfire.Console.Extensions.Serilog" Version="2.1.0" />
		<PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
		<PackageReference Include="Hangfire.MissionControl" Version="0.10.0" />
		<PackageReference Include="NetCoreServer" Version="8.0.7" />
		<PackageReference Include="RJCP.SerialPortStream" Version="3.0.5" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.7" />
		<PackageReference Include="System.IO.Ports" Version="10.0.7" />
		<PackageReference Include="System.Reactive" Version="6.1.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<Content Remove="appsettings.Development.json" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
		<EmbeddedResource Include="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Microgate.Common.Protocol.Rei2">
			<HintPath>Microgate.Common.Protocol.Rei2.dll</HintPath>
		</Reference>
	</ItemGroup>

	<PropertyGroup>
		<RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)</RestoreAdditionalProjectSources>
	</PropertyGroup>

	<!-- Build the editor before resource discovery so clean and single-file publishes embed its assets. -->
	<Target Name="RestoreFlowEditor" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipFrontendBuild)' != 'true'"
		Inputs="ClientApp/package.json;ClientApp/package-lock.json" Outputs="ClientApp/node_modules/.package-lock.json">
		<Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="ClientApp" />
	</Target>
	<Target Name="BuildFlowEditor" BeforeTargets="AssignTargetPaths" DependsOnTargets="RestoreFlowEditor" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipFrontendBuild)' != 'true'"
		Inputs="ClientApp/package-lock.json;ClientApp/package.json;ClientApp/vite.config.ts;ClientApp/tsconfig.json;ClientApp/index.html;@(FlowEditorSource)"
		Outputs="wwwroot/flows/index.html">
		<Exec Command="npm run build" WorkingDirectory="ClientApp" />
	</Target>
	<ItemGroup>
		<FlowEditorSource Include="ClientApp/src/**/*" />
		<Content Remove="ClientApp/**/*" />
	</ItemGroup>
	<Target Name="IncludeFlowEditor" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildFlowEditor">
		<ItemGroup>
			<EmbeddedResource Remove="wwwroot/flows/**" />
			<EmbeddedResource Include="wwwroot/flows/**" CopyToOutputDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>
</Project>
