{
  "Urls": "http://*:8082",
  "Source": {
    "SportidentCenter": {
      "Enable": "false",
      "Events": [
        {
          "EventId": 19640,
          "ApiKey": "",
          "RefreshMs": 100
        }
      ]
    },
    "SIRAP": {
      "Enable": "true",
      "Servers": [
        {
          "Port": 10000
        }
      ]
    },
    "ROC": {
      "Enable": "false",
      "Events": [
        {
          "Enable": false,
          "EventId": 1799,
          "RefreshMs": 0,
          "Host": "https://roc.olresultat.se/",
          "Path": "/getpunches.asp?unitId={EventId}&lastId={LastId}"
        },
        {
          "Enable": false,
          "EventId": 1,
          "RefreshMs": 0,
          "Host": "https://orienteering.services/",
          "Path": "/radiocontrol/getpunches.php?unitId={EventId}&lastId={LastId}"
        },
        {
          // OResults exposes a ROC-compatible endpoint: id;code;card;time
          "Enable": false,
          "EventId": 1799,
          "RefreshMs": 0,
          "Host": "https://api.oresults.eu/",
          "Path": "/roc?unitId={EventId}&lastId={LastId}"
        }
      ]
    },
    "SportidentSerial": {
      "Enable": "false",
      "Ports": [
        {
          "PortName": "COM6",
          "Baudrate": "38400"
        },
        {
          "PortName": "COM11",
          "Baudrate": "38400"
        }
      ]
    },
    "TmFRadio": {
      "Enable": "false",
      "Gateways": [
        {
          "PortName": "COM3",
          "Baudrate": "19200",
          "StatusCheck": 60 // s
        }
      ]
    },
    "MQTT": {
      "Enable": "false",
      "Sources": [
        {
          "Host": "localhost",
          "Port": 1883,
          "UseWebSocket": false,
          "UseTls": false,
          "WebSocketPath": "/mqtt",
          "Topics": [
            "punches"
          ],
          "Protocols": [
            "Sportident",
            "TmF"
          ],
          "SourceId": "MQTT"
        }
      ]
    },
    "Microplus": {
      "Enable": "false",
      "Servers": [
        {
          "Port": 9999,
          "IgnoreCommands": [
            "S"
          ],
          "Filter": "MicroplusMapper"
        }
      ]
    },
    "Microgate": {
      "Enable": "false",
      "Sources": [
        {
          "Address": "127.0.0.1",
          "Port": 21968
        }
      ]
    },
    "OBR": {
      "Enable": "false",
      "Sources": [
        {
          "Port": 5005,
          "AllowedIp": "", // leave empty to accept from any IP
          "SourceId": "OBR"
        }
      ]
    }
  },
  "Enrichment": {
    // Enrichment sources add competitor data (Card↔Bib, name, class, start time) to punches.
    // Activate one on a filter via its "Enrichers" list (see Filters below).
    "Oribos": {
      "Enable": "false",
      "Sources": [
        {
          "Name": "Oribos", // key referenced in a filter's Enrichers
          "Host": "http://localhost:8080",
          "Merged": false, // fullweb merged= flag (multiday)
          "EmitStatusChanges": false // also generate status-change events (DNS/DNF/DSQ/MP/OverTime)
        }
      ]
    }
  },
  "Target": {
    "UI": {
      "Enable": "true"
    },
    "SIRAP": {
      "Enable": "false",
      "Clients": [
        {
          "Address": "localhost",
          "Port": 10000,
          "Version": 2,
          "ZeroTime": "00:00:00"
        }
      ]
    },
    "Tcp": {
      "Enable": "false",
      "Targets": [
        {
          "Address": "127.0.0.1",
          "Port": 1122,
          "AsServer": "false",
          // {Bib}=id only if bib number, {Card}=id only if punching card, {CompetitorId}=id whatever its type
          "Format": "{CompetitorId};{Control};{Time:HH:mm:ss,fff}{CRLF}"
        }
      ]
    },
    "HTTP": {
      "Enable": "false",
      "Targets": [
        {
          "Url": "https://example.com/api?card={CompetitorId}&time={Time:yyyy-MM-ddTHH:mm:ss.fffzzz}&control={Control}&type={Type}",
          "Method": "POST",
          "EnsureSuccessStatusCode": true
        }
      ]
    },
    "Oribos": {
      "Enable": "false",
      "Servers": [
        {
          "Host": "http://localhost:8080"
          // Oribos chooses card or bib endpoints from CompetitorIdType
        }
      ]
    },
    "OResults": {
      "Enable": "false",
      "Servers": [
        {
          "Host": "https://api.oresults.eu/",
          "Path": "/punches/external",
          "ApiKey": "", // event API key from OResults
          "UseUtc": true // send punch times as UTC (RFC3339 'Z'); false sends event-local time
        }
      ]
    },
    "File": {
      "Enable": "false",
      "Files": [
        {
          "Path": "C:\\target.csv",
          "Format": "{ReceivedAt:HH:mm:ss,fff},{CompetitorId},{Type},{Control},{Time:HH:mm:ss,fff},{Source},{Cancellation},{Status}{CRLF}"
        }
      ]
    },
    "Printer": {
      "Enable": "false",
      "Printers": [
        {
          "PrinterName": "NEWPOS",
          "Format": "{CompetitorId} {Type}-{Control} {Time:HH:mm:ss,ffff} {Source} {Status} {Cancellation}",
          "ColumnWidths": [
            8,
            7,
            13,
            8,
            12,
            4
          ]
        }
      ]
    }
  },
  "Dispatcher": {
    "Filter": "Default"
  },
  "Filters": {
    "List": [
      {
        "Name": "Default",
        "Enable": true,
        "IgnoreOlderThan": "0:12:00:00",
        // enrichment sources applied in order (later ones overwrite earlier ones)
        "Enrichers": [
          "Oribos"
        ],
        "MapCompetitorIds": {
          // map to empty to ignore
          "25": "250"
        },
        "MapControls": {
          // map to 0 to exclude a specific control
          "888": 0
        },
        "IncludeOnlyControls": [
          // insert the control codes (as number) to be include
          // if empty all the controls will be included
        ],
        "IncludeOnlyCompetitorIds": [
          // insert the competitor ids (as strings) codes to be include
          // if empty all the competitor ids will be included
        ],
        //"OverrideCompetitorIdType": "PunchingCard",
        "TypeFromCode": {
          "Clear": [
            1,
            16,
            17,
            18,
            19,
            20
          ],
          "Start": [
            21,
            22,
            23,
            24,
            25
          ],
          "Check": [
            11,
            12,
            13,
            14,
            15
          ],
          "Finish": [
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9,
            10,
            26,
            27,
            28,
            29,
            30,
            999
          ]
          // others mapped as Control
        }
      },
      {
        "Name": "MicroplusMapper",
        "Enable": true,
        "TypeFromCode": {
          "Start": [
            -1,
            0
          ],
          "Finish": [
            3,
            99
          ]
          // others mapped as Control
        }
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "HealthChecks": "Warning",
        "Hangfire": "Error"
      }
    }
  }
}