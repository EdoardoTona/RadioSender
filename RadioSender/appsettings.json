{
  "Urls": "http://*:8082",
  "Source": {
    "SportidentCenter": {
      "Enable": "false",
      "Events": [
        {
          "EventId": 19640,
          "ApiKey": "",
          "RefreshMs": 0
        }
      ]
    },
    "SIRAP": {
      "Enable": "true",
      "Servers": [
        {
          "Port": 10000
        }
      ]
    },
    "ROC": {
      "Enable": "false",
      "Events": [
        {
          "EventId": 1799,
          "RefreshMs": 0,
          "Host": "https://roc.olresultat.se/",
          "Path": "/getpunches.asp?unitId={EventId}&lastId={LastId}"
        },
        {
          "EventId": 1,
          "RefreshMs": 0,
          "Host": "https://orienteering.services/",
          "Path": "/radiocontrol/getpunches.php?unitId={EventId}&lastId={LastId}"
        }
      ]
    },
    "SportidentSerial": {
      "Enable": "false",
      "Ports": [
        {
          "PortName": "COM6",
          "Baudrate": "38400"
        },
        {
          "PortName": "COM11",
          "Baudrate": "38400"
        }
      ]
    },
    "TmFRadio": {
      "Enable": "false",
      "Gateways": [
        {
          "PortName": "COM3",
          "Baudrate": "19200",
          "StatusCheck": 60 // s
        }
      ]
    },
    "MQTT": {
      "Enable": "false",
      "Sources": [
        {
          "Host": "localhost",
          "Port": 1883,
          "UseWebSocket": false,
          "UseTls": false,
          "WebSocketPath": "/mqtt",
          "Topics": ["punches"],
          "Protocols": ["Sportident", "TmF"],
          "SourceId": "MQTT"
        }
      ]
    },
    "Microplus": {
      "Enable": "false",
      "Servers": [
        {
          "Port": 9999,
          "IgnoreCommands": ["S"],
          "Filter": "MicroplusMapper"
        }
      ]
    },
    "Microgate": {
      "Enable": "false",
      "Sources": [
        {
          "Address": "127.0.0.1",
          "Port": 21968
        }
      ]
    }
  },
  "Target": {
    "UI": {
      "Enable": "true"
    },
    "SIRAP": {
      "Enable": "false",
      "Clients": [
        {
          "Address": "localhost",
          "Port": 10000,
          "Version": 2,
          "ZeroTime": "00:00:00"
        }
      ]
    },
    "Tcp": {
      "Enable": "false",
      "Targets": [
        {
          "Address": "127.0.0.1",
          "Port": 1122,
          "AsServer": "false",
          "Format": "{Bib};{Control};{Time:HH:mm:ss,fff}{CRLF}"
        }
      ]
    },
    "HTTP": {
      "Enable": "false",
      "Targets": [
        {
          "Url": "https://example.com/api?card={Card}&time={Time:yyyy-MM-ddTHH:mm:ss.fffzzz}&control={Control}&type={Type}",
          "Method": "POST",
          "EnsureSuccessStatusCode": true
        }
      ]
    },
    "Oribos": {
      "Enable": "false",
      "Servers": [
        {
          "Host": "http://localhost:8080",
          "UseStartNumbers": true
        }
      ]
    },
    "File": {
      "Enable": "false",
      "Files": [
        {
          "Path": "C:\\target.csv",
          "Format": "{Card},{Type},{Control},{Time:HH:mm:ss,fff},{Source},{Cancellation},{Status}{CRLF}"
        }
      ]
    },
    "Printer": {
      "Enable": "false",
      "Printers": [
        {
          "PrinterName": "NEWPOS",
          "Format": "{Card} {Type}{Control} {Time:HH:mm:ss,fff} {Source} {Status} {Cancellation}"
        }
      ]
    }
  },
  "Dispatcher": {
    "Filter": "Default"
  },
  "Filters": {
    "List": [
      {
        "Name": "Default",
        "Enable": true,
        "IgnoreOlderThan": "0:12:00:00",
        "MapCards": {
          // map to empty to ignore
          "25": "250"
        },
        "MapControls": {
          // map to 0 to exclude a specific control
          "888": 0
        },
        "IncludeOnlyControls": [
          // insert the control codes (as number) to be include
          // if empty all the controls will be included
        ],
        "IncludeOnlyCards": [
          // insert the cards (as strings) codes to be include
          // if empty all the cards will be included
        ],
        "TypeFromCode": {
          "Clear": [1, 16, 17, 18, 19, 20],
          "Start": [21, 22, 23, 24, 25],
          "Check": [11, 12, 13, 14, 15],
          "Finish": [2, 3, 4, 5, 6, 7, 8, 9, 10, 26, 27, 28, 29, 30, 999]
          // others mapped as Control
        }
      },
      {
        "Name": "MicroplusMapper",
        "Enable": true,
        "TypeFromCode": {
          "Start": [-1, 0],
          "Finish": [3, 99]
          // others mapped as Control
        }
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "HealthChecks": "Warning",
        "Hangfire": "Error"
      }
    }
  }
}
